{
  "expo": {
    "name": "split-easy",
    "slug": "split-easy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "spliteasy",
    "owner": "artinsubject",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0EA39B"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.artinsubject.spliteasy",
      "buildNumber": "1",
      "usesNonExemptEncryption": false
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0EA39B"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-splash-screen"
    ],
    "extra": {
      "eas": {
        "projectId": "ba01a5ce-ebe2-4378-8cd4-2d7ad71f8b69"
      }
    }
  }
}
